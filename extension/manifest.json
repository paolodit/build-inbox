{
  "manifest_version": 3,
  "name": "Build Inbox",
  "description": "Capture voice, screenshots, URL context, and send local build briefs to Codex.",
  "version": "0.1.0",
  "minimum_chrome_version": "114",
  "key": "",
  "icons": {
    "16": "icons/build-16.png",
    "32": "icons/build-32.png",
    "48": "icons/build-48.png",
    "128": "icons/build-128.png"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "nativeMessaging",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open Build Inbox",
    "default_icon": {
      "16": "icons/build-16.png",
      "32": "icons/build-32.png",
      "48": "icons/build-48.png",
      "128": "icons/build-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "toggle-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      },
      "description": "Start or stop Build Inbox capture"
    },
    "take-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Take a Build Inbox screenshot"
    },
    "save-brief": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Save the current Build Inbox capture"
    }
  }
}
